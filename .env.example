# Database (Neon or local Postgres)
DATABASE_URL="postgresql://user:password@host:5432/agentic_commerce?sslmode=require"

# Session cookie signing (generate: openssl rand -hex 32)
SESSION_SECRET="replace-with-a-long-random-hex-string"

# Environment
NODE_ENV="development"

# Feature flags
FEATURE_WEATHER_MODE="mock"  # mock | off | live
FEATURE_EVENTS_MODE="mock"   # mock | off | live

# Rate limiting
RATE_LIMIT_MAX_PER_MIN="30"

# Logging
LOG_LEVEL="info"
