# Database — Neon provides TWO URLs; copy both from the Neon dashboard.
# Pooled connection (pgBouncer) — used by the app at runtime on Vercel serverless
DATABASE_URL="postgresql://user:password@ep-xxx.eu-west-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=10"
# Direct connection (non-pooled) — used only by prisma migrate and seed
DIRECT_URL="postgresql://user:password@ep-xxx.eu-west-1.aws.neon.tech/neondb?sslmode=require"

# Session cookie signing (generate: openssl rand -hex 32)
SESSION_SECRET="replace-with-a-long-random-hex-string"

# Environment
NODE_ENV="development"

# Feature flags
FEATURE_WEATHER_MODE="mock"  # mock | off | live
FEATURE_EVENTS_MODE="mock"   # mock | off | live

# Rate limiting
RATE_LIMIT_MAX_PER_MIN="30"

# Logging
LOG_LEVEL="info"
