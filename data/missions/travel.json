{
  "missionCode": "TRAVEL",
  "version": "1.0.0",
  "disclaimer": "Not medical advice. Speak to a pharmacist.",
  "intentKeywords": {
    "TRAVEL": [
      { "term": "travel", "weight": 0.5 },
      { "term": "trip", "weight": 0.5 },
      { "term": "holiday", "weight": 0.5 },
      { "term": "vacation", "weight": 0.5 },
      { "term": "kit", "weight": 0.2 },
      { "term": "essentials", "weight": 0.2 },
      { "term": "beach", "weight": 0.15 },
      { "term": "abroad", "weight": 0.4 },
      { "term": "flight", "weight": 0.3 },
      { "term": "flying", "weight": 0.3 },
      { "term": "packing", "weight": 0.3 },
      { "term": "sun", "weight": 0.1 },
      { "term": "spf", "weight": 0.3 },
      { "term": "getaway", "weight": 0.4 },
      { "term": "resort", "weight": 0.3 },
      { "term": "destination", "weight": 0.3 },
      { "term": "weekend away", "weight": 0.5 },
      { "term": "city break", "weight": 0.5 },
      { "term": "honeymoon", "weight": 0.5 },
      { "term": "maldives", "weight": 0.5 },
      { "term": "thailand", "weight": 0.5 },
      { "term": "spain", "weight": 0.5 },
      { "term": "portugal", "weight": 0.5 },
      { "term": "greece", "weight": 0.5 },
      { "term": "turkey", "weight": 0.5 },
      { "term": "dubai", "weight": 0.5 },
      { "term": "bali", "weight": 0.5 },
      { "term": "barcelona", "weight": 0.5 },
      { "term": "ibiza", "weight": 0.5 },
      { "term": "tenerife", "weight": 0.5 },
      { "term": "canary islands", "weight": 0.5 },
      { "term": "croatia", "weight": 0.5 },
      { "term": "italy", "weight": 0.5 },
      { "term": "france", "weight": 0.5 },
      { "term": "morocco", "weight": 0.5 },
      { "term": "egypt", "weight": 0.5 }
    ]
  },
  "questions": [
    {
      "id": "q_destination_type",
      "order": 1,
      "text": "What kind of destination?",
      "type": "choice",
      "options": [
        { "value": "beach", "label": "Beach" },
        { "value": "city", "label": "City" },
        { "value": "mixed", "label": "Mixed" },
        { "value": "unknown", "label": "Not sure" }
      ],
      "default": "unknown",
      "critical": true
    },
    {
      "id": "q_duration_days",
      "order": 2,
      "text": "How long is the trip?",
      "type": "number",
      "validation": { "min": 1, "max": 60 },
      "default": 7,
      "critical": true
    },
    {
      "id": "q_traveller_type",
      "order": 3,
      "text": "Who's travelling?",
      "type": "choice",
      "options": [
        { "value": "adult", "label": "Adult" },
        { "value": "child", "label": "Child" },
        { "value": "family", "label": "Family" }
      ],
      "default": "adult",
      "critical": true
    },
    {
      "id": "q_sensitivities",
      "order": 4,
      "text": "Any sensitivities?",
      "type": "multi",
      "options": [
        { "value": "sensitive_skin", "label": "Sensitive skin" },
        { "value": "fragrance_free_preference", "label": "Prefer fragrance-free" }
      ],
      "default": [],
      "critical": false
    },
    {
      "id": "q_urgency",
      "order": 5,
      "text": "How soon do you need it?",
      "type": "choice",
      "options": [
        { "value": "today", "label": "Today" },
        { "value": "1_3_days", "label": "1–3 days" },
        { "value": "flexible", "label": "Flexible" }
      ],
      "default": "flexible",
      "critical": false
    }
  ],
  "requiredCategories": {
    "default": [
      "SUN_CARE",
      "TOILETRIES",
      "HYGIENE",
      "FIRST_AID",
      "HYDRATION"
    ],
    "overrides": [
      {
        "condition": { "destinationType": ["city"], "durationDays": { "lte": 4 } },
        "categories": ["TOILETRIES", "HYGIENE", "FIRST_AID", "LIP_CARE", "MOISTURISER"]
      }
    ]
  },
  "optionalCategories": ["LIP_CARE", "MOISTURISER"],
  "bundleConstraints": {
    "minItems": 6,
    "maxItems": 10,
    "priceBands": ["value", "mid", "premium"],
    "defaultPriceBand": "mid"
  },
  "substitutionGroups": [
    {
      "category": "SUN_CARE",
      "subCategory": "sunscreen_lotion",
      "matchTags": ["sensitiveSkin", "fragranceFree", "spf"]
    },
    {
      "category": "TOILETRIES",
      "subCategory": "deodorant",
      "matchTags": ["aerosol", "fragranceFree"]
    },
    {
      "category": "HYDRATION",
      "subCategory": "electrolyte",
      "matchTags": []
    }
  ],
  "guardrails": {
    "prohibitedLanguage": [
      "diagnose",
      "diagnosis",
      "prescribe",
      "cure",
      "treatment for"
    ],
    "restrictedForChildren": {
      "filterWhenTraveller": ["child", "family"]
    },
    "blockList": [
      "ignore all previous",
      "system prompt",
      "jailbreak"
    ]
  },
  "reasonCodes": {
    "SUN_CARE": "Sun exposure protection",
    "TOILETRIES": "Daily travel hygiene",
    "HYGIENE": "On-the-go cleanliness",
    "FIRST_AID": "Basic travel first aid",
    "HYDRATION": "Hydration support",
    "LIP_CARE": "Lip protection",
    "MOISTURISER": "Skin moisture"
  },
  "whyTemplates": {
    "SUN_CARE_BEACH": "Beach trip — high sun exposure.",
    "SUN_CARE_MIXED": "Some outdoor time expected.",
    "SUN_CARE_UNKNOWN": "Included by default for sun protection.",
    "SUN_CARE_CHILD": "Child-friendly SPF for family trips.",
    "TOILETRIES": "Travel-size essentials.",
    "HYGIENE": "Useful on flights and out and about.",
    "FIRST_AID": "Covers minor cuts and grazes.",
    "HYDRATION": "Helpful in warm climates and long flights.",
    "LIP_CARE_WINTER": "Protects lips in cold or dry conditions.",
    "MOISTURISER_WINTER": "Keeps skin comfortable in cold air.",
    "SENSITIVE_SKIN": "Matches your sensitive-skin preference."
  }
}
